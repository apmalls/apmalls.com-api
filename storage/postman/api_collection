                                                    "raw": "{\n    \"challenge_id\": \"{{login_challenge_id}}\",\n    \"otp\": \"{{login_otp}}\"\n}",
                                                    "options": {
                                                        "raw": {
                                                            "language": "json"
                                                        }
                                                    }
                                                },
                                                "description": "Verify the six-digit email login code. Hashed, single-use, five-minute expiry and five attempts. Account must remain active and verified. Transactional verification consumes the challenge, invalidates outstanding challenges, replaces tokens and returns the normal authenticated response. Signup verification is separate and remains mandatory.",
